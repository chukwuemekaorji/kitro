# copy this file to .env before running docker-compose up — real .env is gitignored

# used by the postgres image to initialize the db on first boot
POSTGRES_USER=kitro
POSTGRES_PASSWORD=changeme
POSTGRES_DB=kitro

# used by the backend to connect — same credentials as above, host is the
# compose service name "db", not localhost
DATABASE_URL=postgresql://kitro:changeme@db:5432/kitro

# used to sign JWTs — generate a real random value for anything beyond a laptop demo
JWT_SECRET=changeme-generate-a-real-secret
